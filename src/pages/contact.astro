---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { parametres as p } from '../lib/parametres';

const page = await getEntry('pages', 'contact');
if (!page) throw new Error('Contenu manquant : src/content/pages/contact.md');
const c = page.data;
const { Content } = await render(page);
---

<Base titre={c.titre} description={c.meta_description}>
  <PageHero titre={c.hero_titre} script={c.hero_script} intro={c.hero_intro} />

  <section class="contact">
    <div class="wrap contact__grille">
      <div class="reveal">
        <ContactForm titre="Votre message" />
      </div>

      <aside class="coordonnees reveal">
        <h2 class="coordonnees__titre">Me joindre directement</h2>

        <ul class="coordonnees__liste">
          <li>
            <span class="coordonnees__icone"><Icon nom="telephone" taille={19} /></span>
            <div>
              <strong>Téléphone</strong>
              <a href={`tel:${p.telephone_lien}`}>{p.telephone}</a>
            </div>
          </li>
          <li>
            <span class="coordonnees__icone"><Icon nom="email" taille={19} /></span>
            <div>
              <strong>E-mail</strong>
              <a href={`mailto:${p.email}`}>{p.email}</a>
            </div>
          </li>
          <li>
            <span class="coordonnees__icone"><Icon nom="lieu" taille={19} /></span>
            <div>
              <strong>Cabinet</strong>
              <span>{p.adresse_ligne1}<br />{p.adresse_ligne2}</span>
            </div>
          </li>
          {
            p.horaires && (
              <li>
                <span class="coordonnees__icone">
                  <Icon nom="agenda" taille={19} />
                </span>
                <div>
                  <strong>Disponibilités</strong>
                  <span>{p.horaires}</span>
                </div>
              </li>
            )
          }
        </ul>

        <div class="rich coordonnees__texte">
          <Content />
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact {
    padding-bottom: var(--space-xl);
  }

  .contact__grille {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }

  .coordonnees__titre {
    font-size: var(--step-2);
    margin-bottom: var(--space-s);
  }

  .coordonnees__liste {
    list-style: none;
    padding: 0;
    margin-bottom: var(--space-m);
  }

  .coordonnees__liste li {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .coordonnees__icone {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--sage-tint);
    color: var(--sage);
  }

  .coordonnees__liste strong {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.2rem;
  }

  .coordonnees__liste a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--gold-line);
  }

  .coordonnees__liste a:hover {
    color: var(--gold-text);
  }

  .coordonnees__texte {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .coordonnees__texte :global(h2) {
    font-size: var(--step-1);
    color: var(--ink);
  }

  @media (width >= 58rem) {
    .contact__grille {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }
</style>
