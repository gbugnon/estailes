---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Coordonnees from '../components/Coordonnees.astro';

const page = await getEntry('pages', 'contact');
if (!page) throw new Error('Contenu manquant : src/content/pages/contact.md');
const c = page.data;
const { Content } = await render(page);
---

<Base titre={c.titre} description={c.meta_description}>
  <PageHero titre={c.hero_titre} script={c.hero_script} intro={c.hero_intro} />

  <section class="contact">
    <div class="wrap contact__grille">
      <div class="rich contact__texte reveal">
        <Content />
      </div>

      <aside class="coordonnees reveal">
        <h2 class="coordonnees__titre">Me joindre directement</h2>
        <Coordonnees avecAdresse />
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact {
    padding-bottom: var(--space-xl);
  }

  .contact__grille {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }

  .coordonnees__titre {
    font-size: var(--step-2);
    margin-bottom: var(--space-s);
  }

  @media (width >= 58rem) {
    .contact__grille {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }
</style>
