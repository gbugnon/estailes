---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PrestationCard from '../../components/PrestationCard.astro';

const page = await getEntry('pages', 'prestations');
if (!page) throw new Error('Contenu manquant : src/content/pages/prestations.md');
const c = page.data;

const prestations = (await getCollection('prestations')).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
---

<Base titre={c.titre} description={c.meta_description}>
  <PageHero titre={c.hero_titre} script={c.hero_script} intro={c.hero_intro} />

  <section class="liste">
    <div class="wrap liste__grille">
      {
        prestations.map((prestation, i) => (
          <div class="reveal" style={`transition-delay:${i * 80}ms`}>
            <PrestationCard prestation={prestation} eager={i < 2} />
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .liste {
    padding-bottom: var(--space-xl);
  }

  .liste__grille {
    display: grid;
    gap: var(--space-m) var(--space-s);
    grid-template-columns: 1fr;
    justify-content: center;
  }

  @media (width >= 34rem) {
    .liste__grille {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Une fiche seule en dernière ligne se centre au lieu de rester à gauche. */
    .liste__grille > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
      width: calc(50% - var(--space-s) / 2);
      justify-self: center;
    }
  }

  @media (width >= 68rem) {
    /* Trois fiches par rangée, jamais plus : à cinq prestations, `auto-fit` en
       logeait quatre et laissait la cinquième seule, calée à gauche. Le plafond
       de largeur vaut exactement trois fiches et leurs deux gouttières, ce qui
       provoque le retour à la ligne.

       Flex et non grille : c'est ce qui centre une dernière rangée incomplète.
       La grille, elle, aligne toujours ses items sur les colonnes. Le rattrapage
       d'orphelin des deux colonnes devient inutile ici — `flex-basis` l'emporte
       sur la largeur qu'il posait. */
    .liste__grille {
      display: flex;
      flex-wrap: wrap;
      max-width: calc(3 * 17rem + 2 * var(--space-s));
      margin-inline: auto;
    }

    .liste__grille > * {
      flex: 0 0 17rem;
    }
  }
</style>
