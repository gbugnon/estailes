---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Sparkles from '../../components/Sparkles.astro';
import Photo from '../../components/Photo.astro';

export const getStaticPaths = (async () => {
  const prestations = await getCollection('prestations');
  return prestations.map((prestation) => ({
    params: { slug: prestation.id },
    props: { prestation },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { prestation } = Astro.props;
const c = prestation.data;
const { Content } = await render(prestation);

const autres = (await getCollection('prestations'))
  .filter((p) => p.id !== prestation.id)
  .sort((a, b) => a.data.ordre - b.data.ordre);
---

<Base titre={c.titre} description={c.meta_description}>
  <article>
    <header class="tete">
      <Sparkles
        class="tete__etincelles"
        etincelles={[
          { x: 6, y: 24, r: 9, opacite: 0.5 },
          { x: 95, y: 62, r: 11, opacite: 0.4 },
        ]}
      />

      <div class="wrap tete__inner">
        <div class="tete__texte">
          <nav class="fil" aria-label="Fil d'Ariane">
            <a href="/prestations">Prestations</a>
            <span aria-hidden="true">·</span>
            <span>{c.titre}</span>
          </nav>

          <h1>{c.titre}</h1>
          {c.sous_titre && <p class="tete__sous-titre">{c.sous_titre}</p>}

          <dl class="pratique">
            {
              c.duree && (
                <div>
                  <dt>Durée</dt>
                  <dd>{c.duree}</dd>
                </div>
              )
            }
            {
              c.prix && (
                <div>
                  <dt>Tarif</dt>
                  <dd>{c.prix}</dd>
                </div>
              )
            }
          </dl>

          <a href="/rendez-vous" class="btn btn--primary tete__cta">
            Réserver cette séance
            <Icon nom="agenda" taille={16} />
          </a>
        </div>

        <div class="tete__media">
          <Photo
            src={c.image}
            alt={c.image_alt}
            position={c.image_position}
            width={760}
            height={640}
            sizes="(min-width: 56rem) 50vw, 100vw"
            loading="eager"
            fetchpriority="high"
          />
          <span class="tete__pastille">
            <Icon nom={c.icone} taille={30} />
          </span>
        </div>
      </div>
    </header>

    <div class="corps">
      <div class="wrap">
        <div class="rich prose reveal">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <section class="autres">
    <div class="wrap">
      <h2 class="autres__titre">Autres prestations</h2>
      <ul class="autres__liste">
        {
          autres.map((p) => (
            <li>
              <a href={`/prestations/${p.id}`}>
                <span class="autres__icone">
                  <Icon nom={p.data.icone} taille={22} />
                </span>
                <span>
                  <strong>{p.data.titre}</strong>
                  {p.data.duree && <em>{p.data.duree}</em>}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .tete {
    position: relative;
    padding-block: var(--space-l) var(--space-xl);
    overflow: hidden;
  }

  .tete__inner {
    position: relative;
    z-index: 3;
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  .fil {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
    margin-bottom: var(--space-s);
  }

  .fil a {
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--gold-line);
  }

  .fil a:hover {
    color: var(--gold-text);
  }

  .tete h1 {
    font-size: var(--step-6);
  }

  .tete__sous-titre {
    margin-top: 0.5rem;
    font-family: var(--font-script);
    font-size: var(--step-3);
    color: var(--gold-text);
    line-height: 1.2;
  }

  .pratique {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-top: var(--space-m);
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
  }

  .pratique dt {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.25rem;
  }

  .pratique dd {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 60;
    font-weight: 300;
    font-size: var(--step-2);
  }

  .tete__cta {
    margin-top: var(--space-m);
  }

  .tete__media {
    position: relative;
  }

  .tete__media :global(img) {
    width: 100%;
    aspect-ratio: 6 / 5;
    object-fit: cover;
    border-radius: 999px 12px 12px 999px;
  }

  .tete__pastille {
    position: absolute;
    left: 50%;
    bottom: 0;
    translate: -50% 45%;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--panel);
    border: 1px solid var(--gold-line);
    color: var(--gold-text);
    box-shadow: 0 6px 18px -8px rgb(55 52 46 / 35%);
  }

  .corps {
    padding-block: var(--space-m) var(--space-xl);
  }

  .corps .prose {
    margin-inline: auto;
  }

  .autres {
    background: var(--cream-deep);
    border-block: 1px solid var(--line);
    padding-block: var(--space-l);
  }

  .autres__titre {
    font-size: var(--step-2);
    margin-bottom: var(--space-s);
  }

  .autres__liste {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    list-style: none;
    padding: 0;
  }

  .autres__liste a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    height: 100%;
    padding: 0.9rem 1.1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    text-decoration: none;
    transition:
      border-color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .autres__liste a:hover {
    border-color: var(--gold-line);
    transform: translateY(-2px);
  }

  .autres__icone {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--sage-tint);
    color: var(--sage);
  }

  .autres__liste strong {
    display: block;
    font-weight: 600;
    font-size: var(--step--1);
  }

  .autres__liste em {
    display: block;
    font-style: normal;
    font-size: 0.8rem;
    color: var(--ink-muted);
  }

  @media (width >= 56rem) {
    .tete__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .tete__media {
      margin-right: calc(50% - 50vw);
    }

    .tete__media :global(img) {
      border-radius: 999px 0 0 999px;
    }

    .tete__pastille {
      left: 0;
      bottom: 50%;
      translate: -50% 50%;
    }
  }
</style>
