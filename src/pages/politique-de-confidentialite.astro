---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

const page = await getEntry('pages', 'politique-de-confidentialite');
if (!page) throw new Error('Contenu manquant : src/content/pages/politique-de-confidentialite.md');
const c = page.data;
const { Content } = await render(page);
---

<Base titre={c.titre} description={c.meta_description}>
  <PageHero titre={c.hero_titre} script={c.hero_script} intro={c.hero_intro} />

  <section class="corps">
    <div class="wrap">
      <div class="rich prose">
        <Content />
      </div>
    </div>
  </section>
</Base>

<style>
  .corps {
    padding-bottom: var(--space-xl);
  }

  .corps .prose {
    margin-inline: auto;
  }
</style>
