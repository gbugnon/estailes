---
import Icon from './Icon.astro';
import Sparkles from './Sparkles.astro';
import { parametres as p } from '../lib/parametres';
---

<section class="bande">
  <Sparkles
    class="bande__etincelles"
    etincelles={[
      { x: 6, y: 26, r: 11, opacite: 0.5 },
      { x: 13, y: 72, r: 6, opacite: 0.35 },
      { x: 92, y: 30, r: 9, opacite: 0.45 },
      { x: 84, y: 78, r: 5, opacite: 0.3 },
    ]}
  />

  <div class="wrap bande__inner">
    <h2 class="bande__titre">
      {p.cta_titre}
      {p.cta_script && <span class="script bande__script">{p.cta_script}</span>}
    </h2>

    <div class="bande__aparte">
      <p>{p.cta_texte}</p>
      <a href="/rendez-vous" class="btn btn--on-sage">
        {p.cta_bouton}
        <Icon nom="agenda" taille={16} />
      </a>
    </div>
  </div>
</section>

<style>
  .bande {
    position: relative;
    background: var(--sage);
    color: #fff;
    padding-block: var(--space-xl);
    overflow: hidden;
  }

  .bande__etincelles {
    color: var(--gold-line);
  }

  .bande__inner {
    position: relative;
    z-index: 3;
    display: grid;
    gap: var(--space-m);
    align-items: center;
  }

  .bande__titre {
    color: #fff;
    text-align: center;
    font-size: var(--step-4);
  }

  .bande__script {
    /* L'accroche manuscrite passe en blanc cassé : l'or ne tient pas le
       contraste sur le vert. */
    color: #f4ecdc;
    margin-top: 0.1em;
  }

  .bande__aparte {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
    text-align: center;
  }

  .bande__aparte p {
    color: rgb(255 255 255 / 88%);
    max-width: 26rem;
    font-size: var(--step-0);
  }

  @media (width >= 56rem) {
    .bande__inner {
      grid-template-columns: 1fr auto 1fr;
      gap: var(--space-l);
    }

    .bande__titre {
      text-align: right;
    }

    /* Le filet vertical ne sépare qu'au-delà de deux colonnes. */
    .bande__aparte {
      grid-column: 3;
      align-items: flex-start;
      text-align: left;
      padding-left: var(--space-l);
      border-left: 1px solid rgb(255 255 255 / 22%);
    }
  }
</style>
