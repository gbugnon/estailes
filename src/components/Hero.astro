---
import Icon from './Icon.astro';
import Sparkles from './Sparkles.astro';
import Photo from './Photo.astro';
import { parametres as reglages } from '../lib/parametres';
import type { PositionPhoto } from './Photo.astro';

interface Props {
  titre: string;
  script?: string;
  intro?: string;
  image?: string;
  imageAlt?: string;
  imagePosition?: PositionPhoto;
  ctaTexte?: string;
  ctaLien?: string;
}

const {
  titre,
  script,
  intro,
  image,
  imageAlt = '',
  imagePosition,
  ctaTexte,
  ctaLien,
} = Astro.props;

// hero_intro accepte plusieurs paragraphes séparés par une ligne vide.
const paragraphes = intro?.split(/\n{2,}/).filter(Boolean) ?? [];

/**
 * Le nom du cabinet est composé dans la script au milieu du texte courant,
 * pour qu'il se détache.
 *
 * Repéré automatiquement à partir de `nom_site` : elle n'a aucune syntaxe à
 * retenir, et un changement d'enseigne suit tout seul. Repérage insensible à
 * la casse, pour qu'elle reste libre d'écrire « les sens d'Estelle » en cours
 * de phrase — c'est sa graphie qui est rendue, pas celle des paramètres. Le
 * découpage produit un tableau rendu en JSX — jamais de set:html, donc le
 * texte venu du CMS reste échappé par Astro et rien ne peut être injecté.
 */
const nom = reglages.nom_site;
const motifNom = new RegExp(`(${nom.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
---

<section class="hero">
  <div class="wrap hero__inner">
    <div class="hero__texte">
      <h1 class="hero__titre">
        {titre}
        {script && <span class="script hero__script">{script}</span>}
      </h1>

      {
        paragraphes.map((para) => (
          <p class="hero__intro">
            {para
              .split(motifNom)
              .map((bout) =>
                bout.toLowerCase() === nom.toLowerCase() ? (
                  <span class="hero__marque">{bout}</span>
                ) : (
                  bout
                ),
              )}
          </p>
        ))
      }

      {
        ctaTexte && ctaLien && (
          <a href={ctaLien} class="btn btn--primary hero__cta">
            {ctaTexte}
            <Icon nom="fleche" taille={15} />
          </a>
        )
      }
    </div>

    {
      image && (
        <div class="hero__media">
          <svg class="hero__arc" viewBox="0 0 200 200" aria-hidden="true">
            <circle cx="100" cy="100" r="99" fill="none" stroke="var(--gold-line)" stroke-width="0.7" />
          </svg>
          <Photo
            src={image}
            alt={imageAlt}
            position={imagePosition}
            width={880}
            height={700}
            sizes="(min-width: 62rem) 55vw, 100vw"
            loading="eager"
            fetchpriority="high"
          />
          {/* Écartées du tracé du cercle. Celui-ci a pour centre (hauteur/2 moins
              le débord, mi-hauteur) et pour rayon la moitié de la hauteur : à
              mi-hauteur son bord passe pile là où se trouvaient les deux
              premières étincelles. On les tient donc en haut et en bas, où le
              cercle s'éloigne — vérifié à 1200 et 1600 px de large. */}
          <Sparkles
            class="hero__etincelles"
            etincelles={[
              { x: 3, y: 8, r: 10, opacite: 0.9 },
              { x: -3, y: 88, r: 5, opacite: 0.6 },
              { x: 8, y: 78, r: 7, opacite: 0.75 },
            ]}
          />
        </div>
      )
    }
  </div>
</section>

<style>
  /* Aucune respiration sur le bloc lui-même : sur la maquette la photo touche
     l'en-tête en haut et la bande des valeurs en bas. L'air est redonné à la
     colonne de texte seule (.hero__texte), sinon le titre collerait au menu. */
  .hero {
    position: relative;
    padding-block: 0;
    overflow: hidden;
  }

  .hero__texte {
    padding-block: var(--space-l) var(--space-xl);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  .hero__titre {
    margin-bottom: var(--space-s);
  }

  .hero__script {
    margin-top: 0.08em;
  }

  .hero__intro {
    color: var(--ink-muted);
    max-width: 32rem;
  }

  .hero__intro + .hero__intro {
    margin-top: 0.9rem;
  }

  /* Le nom du cabinet dans la script, la même face que « harmonie intérieure ».
     Parisienne dessine bien plus petit que la sans à taille égale : d'où la
     correction, calquée sur celle de `.script`. Pas de couleur ni de fond —
     c'est la lettre seule qui marque. */
  .hero__marque {
    font-family: var(--font-script);
    font-size: 1.28em;
    letter-spacing: 0.005em;
    color: var(--ink);
  }

  .hero__cta {
    margin-top: var(--space-m);
  }

  .hero__media {
    position: relative;
    isolation: isolate;
  }

  .hero__media :global(img) {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    border-radius: 999px 12px 12px 999px;
  }

  /* La photo est déjà à l'écran au chargement : elle n'a pas de révélation au
     défilement comme le reste de la page, et surgissait donc d'un coup quand le
     WebP finissait de se décoder. D'où l'impression de clignotement.

     Fondu à l'ouverture, sans JS. `both` retient l'opacité à zéro avant le
     premier tour — sans lui, la photo apparaît pleine puis repart de zéro, ce
     qui aggrave le défaut au lieu de le corriger.

     Le mouvement réduit est déjà couvert par la règle globale, qui ramène toute
     animation à 0,01 ms. */
  .hero__media :global(img) {
    animation: hero-apparition 0.6s var(--ease) both;
  }

  @keyframes hero-apparition {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Le cercle doré a exactement le rayon de l'arrondi gauche de la photo :
     celui-ci vaut la moitié de la hauteur (border-radius 999px, donc plafonné),
     donc un cercle de diamètre égal à la hauteur épouse la courbe au pixel.
     Décalé à gauche de --hero-arc-debord, il n'en laisse dépasser qu'un
     croissant régulier — le reste passe sous la photo. */
  .hero__arc {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: calc(-1 * var(--hero-arc-debord));
    height: 100%;
    width: auto;
    aspect-ratio: 1;
    translate: 0 -50%;
    overflow: visible;
  }

  .hero__etincelles {
    z-index: 2;
  }

  @media (width < 48rem) {
    .hero__media :global(img) {
      border-radius: 140px 10px 10px 140px;
    }
  }

  @media (width >= 62rem) {
    .hero__texte {
      padding-block: var(--space-m) var(--space-2xl);
    }

    .hero__inner {
      grid-template-columns: var(--hero-colonnes);
      gap: var(--space-xl);
    }

    /* La photo file jusqu'au bord droit de la fenêtre, comme sur la maquette,
       et occupe toute la hauteur de la bande : centrée, elle laissait 59 px de
       crème au-dessus et en dessous.

       La photo est sortie du flux : c'est la colonne de texte qui fixe la
       hauteur de la bande, et l'image la remplit. Sans cela une photo au
       cadrage portrait impose sa propre hauteur — ici 1149 px au lieu de 776. */
    .hero__media {
      position: relative;
      align-self: stretch;
      margin-right: calc(50% - 50vw);
    }

    .hero__media :global(img) {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
      height: 100%;
      border-radius: 999px 0 0 999px;
    }
  }
</style>
