---
/**
 * Jeu d'icônes du site. Toute icône ajoutée ici doit également être déclarée
 * dans src/content.config.ts (enum `iconName`) et dans public/admin/config.yml,
 * sinon elle ne sera pas proposée dans le CMS.
 */
const NOMS = [
  'coeur', 'temps', 'presence', 'liens', 'respect', 'nature', 'douceur',
  'pieds', 'tete', 'energie', 'famille',
  'telephone', 'email', 'lieu', 'agenda', 'fleche',
  'facebook', 'instagram', 'linkedin',
] as const;

export type NomIcone = (typeof NOMS)[number];

interface Props {
  nom: NomIcone;
  taille?: number;
  class?: string;
}

const { nom, taille = 24, class: className } = Astro.props;

// Les icônes de marque sont pleines ; toutes les autres sont au trait.
const pleines = new Set<NomIcone>(['facebook', 'instagram', 'linkedin']);
const estPleine = pleines.has(nom);
---

<svg
  class={className}
  width={taille}
  height={taille}
  viewBox="0 0 24 24"
  fill={estPleine ? 'currentColor' : 'none'}
  stroke={estPleine ? 'none' : 'currentColor'}
  stroke-width="1.3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {nom === 'coeur' && <path d="M12 20.4C9.6 18.7 4.4 15 4.4 10.8A4 4 0 0 1 12 8.7a4 4 0 0 1 7.6 2.1c0 4.2-5.2 7.9-7.6 9.6Z" />}

  {
    nom === 'temps' && (
      <>
        <circle cx="12" cy="12" r="8.2" />
        <path d="M12 7.2V12l3.1 1.9" />
      </>
    )
  }

  {
    nom === 'presence' && (
      <>
        <circle cx="12" cy="8.2" r="3.3" />
        <path d="M5.2 19.6c0-3.7 3-6.2 6.8-6.2s6.8 2.5 6.8 6.2" />
      </>
    )
  }

  {
    nom === 'liens' && (
      <>
        <circle cx="8.9" cy="8.8" r="2.7" />
        <circle cx="16.4" cy="9.6" r="2.2" />
        <path d="M3.6 18.9c0-3 2.4-5.1 5.3-5.1s5.3 2.1 5.3 5.1" />
        <path d="M15.5 14c2.9.1 4.9 2.1 4.9 4.9" />
      </>
    )
  }

  {
    nom === 'respect' && (
      <>
        <path d="M5.1 19.2C4.4 11.4 9.6 5.6 19.4 4.6c1 8.6-4.5 14.2-14.3 14.6Z" />
        <path d="M5.4 19.4c2.4-3.8 5.6-6.9 9.4-9.1" />
      </>
    )
  }

  {
    nom === 'nature' && (
      <>
        <path d="M12 20.4v-7.6" />
        <path d="M12 12.8C12 9.1 9.2 6.4 5.4 6.4c0 3.6 2.8 6.4 6.6 6.4Z" />
        <path d="M12 12.8c0-3.4 2.7-6.1 6.3-6.1 0 3.4-2.7 6.1-6.3 6.1Z" />
      </>
    )
  }

  {
    nom === 'douceur' && (
      <>
        <path d="M19 5.1c2.1 4.3-.9 9.6-5.3 11.4l-5.2 1.5 1.1-5.4C11 8.2 16.6 3.1 19 5.1Z" />
        <path d="M8.5 18 4.7 21.4" />
        <path d="M16.4 7.6 10 14.2" />
      </>
    )
  }

  {
    nom === 'pieds' && (
      <>
        <path d="M10.6 21c-1.6 0-2.5-3.4-2.5-6.4 0-2.6 1-4.6 2.5-4.6s2.5 2 2.5 4.6c0 3-.9 6.4-2.5 6.4Z" />
        <circle cx="7.6" cy="6.4" r="1.2" />
        <circle cx="10.5" cy="4.6" r="1.2" />
        <circle cx="13.5" cy="5.2" r="1.1" />
        <circle cx="16" cy="7.2" r="1" />
        <path d="M17.9 20.2c-.9 0-1.5-2-1.5-3.8 0-1.5.6-2.7 1.5-2.7s1.5 1.2 1.5 2.7c0 1.8-.6 3.8-1.5 3.8Z" />
      </>
    )
  }

  {
    nom === 'tete' && (
      <>
        <path d="M15.6 20.6v-2.4a7.4 7.4 0 1 0-7.3-.1v2.5" />
        <path d="M12 14.6c-1.4 0-2.4-1-2.4-2.2s.9-2 2-2 1.8.7 1.8 1.6-.7 1.4-1.4 1.4" />
      </>
    )
  }

  {
    nom === 'energie' && (
      <>
        <path d="m12 3.4 1.7 4.9 4.9 1.7-4.9 1.7L12 16.6l-1.7-4.9-4.9-1.7 4.9-1.7Z" />
        <path d="m18.8 15.4.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7Z" />
        <path d="m5 17.2.5 1.4 1.4.5-1.4.5L5 21l-.5-1.4-1.4-.5 1.4-.5Z" />
      </>
    )
  }

  {
    nom === 'famille' && (
      <>
        <circle cx="8.4" cy="6.3" r="2.6" />
        <path d="M3.7 19.8c0-3.3 2.1-5.6 4.7-5.6s4.7 2.3 4.7 5.6" />
        <circle cx="17" cy="12.2" r="2" />
        <path d="M13.6 19.8c0-2.3 1.5-3.9 3.4-3.9s3.4 1.6 3.4 3.9" />
      </>
    )
  }

  {
    nom === 'telephone' && (
      <path d="M6.3 3.8h3l1.5 3.7-1.9 1.4a11.6 11.6 0 0 0 5.2 5.2l1.4-1.9 3.7 1.5v3a2 2 0 0 1-2.2 2A16.6 16.6 0 0 1 4.3 6a2 2 0 0 1 2-2.2Z" />
    )
  }

  {
    nom === 'email' && (
      <>
        <rect x="3.2" y="5.4" width="17.6" height="13.2" rx="2" />
        <path d="m3.6 6.7 8.4 6 8.4-6" />
      </>
    )
  }

  {
    nom === 'lieu' && (
      <>
        <path d="M12 21c4-4.4 6.1-7.8 6.1-10.6A6.1 6.1 0 0 0 5.9 10.4C5.9 13.2 8 16.6 12 21Z" />
        <circle cx="12" cy="10.3" r="2.3" />
      </>
    )
  }

  {
    nom === 'agenda' && (
      <>
        <rect x="3.4" y="5.2" width="17.2" height="15.4" rx="2" />
        <path d="M3.4 9.9h17.2M8.2 3.4v3.6M15.8 3.4v3.6" />
      </>
    )
  }

  {nom === 'fleche' && <path d="M4.5 12h14m-5.4-5.4L18.5 12l-5.4 5.4" />}

  {
    nom === 'facebook' && (
      <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94Z" />
    )
  }

  {
    nom === 'instagram' && (
      <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.26.07 1.64.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 5.17a4.67 4.67 0 1 0 0 9.34 4.67 4.67 0 0 0 0-9.34Zm0 7.7a3.03 3.03 0 1 1 0-6.06 3.03 3.03 0 0 1 0 6.06Zm5.95-7.89a1.09 1.09 0 1 1-2.18 0 1.09 1.09 0 0 1 2.18 0Z" />
    )
  }

  {
    nom === 'linkedin' && (
      <path d="M6.94 5.5a2.06 2.06 0 1 1-4.12 0 2.06 2.06 0 0 1 4.12 0ZM3.1 21.5h3.66V9.2H3.1v12.3ZM9.3 9.2h3.5v1.68h.05c.49-.92 1.68-1.9 3.46-1.9 3.7 0 4.39 2.44 4.39 5.6v6.92h-3.66v-6.13c0-1.46-.03-3.35-2.04-3.35-2.04 0-2.35 1.6-2.35 3.24v6.24H9.3V9.2Z" />
    )
  }
</svg>
