---
/**
 * Logo Les sens d'Estelle — fichier officiel de la charte (design/charte/).
 * Servi en <img> plutôt qu'inliné : le tracé fait ~49 Ko à cause de la traînée
 * d'étoiles, et il apparaît deux fois par page sur quatorze pages. En fichier
 * externe il n'est téléchargé qu'une fois, puis mis en cache.
 * Le lettrage est déjà vectorisé : aucune dépendance à une police.
 */
interface Props {
  /** Ligne d'accroche affichée sous le logo (pied de page). */
  baseline?: string;
  class?: string;
}

const { baseline, class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <img class="logo__img" src="/images/logo.svg" alt="Les sens d’Estelle" width="438" height="429" />
  {baseline && <span class="logo__baseline">{baseline}</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    line-height: 1;
  }

  /* Le logo est quasi carré (438 × 429) : on le dimensionne en hauteur. */
  .logo__img {
    display: block;
    height: var(--logo-h, 72px);
    width: auto;
  }

  .logo__baseline {
    font-size: 0.62rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-align: center;
  }
</style>
