---
import Icon from './Icon.astro';
import Sparkles from './Sparkles.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  titre: string;
  intro?: string;
  valeurs: CollectionEntry<'valeurs'>[];
}

const { titre, intro, valeurs } = Astro.props;
---

<section class="valeurs">
  <div class="wrap">
    <div class="section-head reveal">
      <h2>{titre}</h2>
      {intro && <p>{intro}</p>}
    </div>

    <div class="valeurs__zone">
      {/* Étincelles de la maquette : deux grandes aux extrémités du fil, trois
          plus discrètes le long du tracé. Surcouche SVG indépendante, comme
          partout ailleurs — jamais incrustée dans une image. */}
      <Sparkles
        class="valeurs__etincelles"
        etincelles={[
          { x: 1, y: 6, r: 11, opacite: 0.85 },
          { x: 21, y: 2, r: 5, opacite: 0.5 },
          { x: 50, y: 8, r: 6, opacite: 0.55 },
          { x: 78, y: 1, r: 5, opacite: 0.5 },
          { x: 99, y: 5, r: 10, opacite: 0.8 },
        ]}
      />

      {/* Le fil doré relie les sept valeurs. Purement décoratif : il disparaît
          dès que la rangée se replie en grille. */}
      <svg class="valeurs__fil" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M0 34 C 100 4, 200 62, 300 32 S 500 2, 600 30 S 800 60, 900 30 S 1100 4, 1200 32"
          fill="none"
          stroke="var(--gold-line)"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-dasharray="1 8"
        />
      </svg>

      <ul class="valeurs__grille">
        {
          valeurs.map((valeur, i) => (
            <li class="valeur reveal" style={`transition-delay:${i * 60}ms`}>
              <span class="valeur__icone">
                <Icon nom={valeur.data.icone} taille={30} />
              </span>
              <h3 class="valeur__titre">{valeur.data.titre}</h3>
              <p class="valeur__desc">{valeur.data.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .valeurs {
    background: var(--cream-deep);
    padding-block: var(--space-xl);
    border-block: 1px solid var(--line);
  }

  .valeurs__zone {
    position: relative;
  }

  /* Les étincelles suivent le fil : masquées tant qu'il l'est, c'est-à-dire
     tant que la rangée est repliée en grille. */
  .valeurs__etincelles {
    display: none;
  }

  .valeurs__fil {
    display: none;
    position: absolute;
    top: 0.9rem;
    left: 0;
    width: 100%;
    height: 60px;
  }

  .valeurs__grille {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m) var(--space-s);
    list-style: none;
    padding: 0;
  }

  .valeur {
    text-align: center;
  }

  .valeur__icone {
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    margin: 0 auto 0.9rem;
    border-radius: 50%;
    color: var(--ink);
    background: var(--cream-deep);
  }

  .valeur__titre {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 0.45rem;
  }

  .valeur__desc {
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--ink-muted);
    max-width: 15rem;
    margin-inline: auto;
  }

  /* Sept valeurs sur deux colonnes : la septième restait seule et calée à
     gauche, avec la moitié de la rangée vide à sa droite. Elle reprend la
     largeur d'une colonne et se centre — même rattrapage que la liste des
     prestations.

     Borné à la bande deux colonnes : au-delà la grille passe à quatre puis à
     sept, où « dernier enfant de rang impair » ne désigne plus un orphelin. */
  @media (width < 40rem) {
    .valeurs__grille > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
      width: calc(50% - var(--space-s) / 2);
      justify-self: center;
    }
  }

  /* Bande tablette : quatre par rangée, donc 4 + 3, et la seconde rangée
     restait calée à gauche avec une colonne entière de vide à sa droite.

     Flex et non grille, comme pour les fiches de prestations : c'est ce qui
     centre une dernière rangée incomplète. Trois éléments dans une rangée de
     quatre ne se rattrapent pas au `nth-child` — contrairement à l'orpheline
     unique de la bande deux colonnes juste au-dessus. La base de flex vaut une
     colonne sur quatre, gouttières déduites.

     Au-delà de 64rem la grille reprend la main : les sept tiennent sur une
     ligne, il n'y a plus de rangée incomplète à centrer. */
  @media (width >= 40rem) and (width < 64rem) {
    .valeurs__grille {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }

    .valeurs__grille > * {
      flex: 0 0 calc((100% - 3 * var(--space-s)) / 4);
    }
  }

  @media (width >= 64rem) {
    .valeurs__fil,
    .valeurs__etincelles {
      display: block;
    }

    .valeurs__grille {
      grid-template-columns: repeat(7, 1fr);
      gap: var(--space-s) 0.75rem;
    }

    .valeur__desc {
      font-size: 0.8rem;
    }
  }
</style>
