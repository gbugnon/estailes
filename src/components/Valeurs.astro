---
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  titre: string;
  intro?: string;
  valeurs: CollectionEntry<'valeurs'>[];
}

const { titre, intro, valeurs } = Astro.props;
---

<section class="valeurs">
  <div class="wrap">
    <div class="section-head reveal">
      <h2>{titre}</h2>
      {intro && <p>{intro}</p>}
    </div>

    <div class="valeurs__zone">
      {/* Le fil doré relie les sept valeurs. Purement décoratif : il disparaît
          dès que la rangée se replie en grille. */}
      <svg class="valeurs__fil" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M0 34 C 100 4, 200 62, 300 32 S 500 2, 600 30 S 800 60, 900 30 S 1100 4, 1200 32"
          fill="none"
          stroke="var(--gold-line)"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-dasharray="1 8"
        />
      </svg>

      <ul class="valeurs__grille">
        {
          valeurs.map((valeur, i) => (
            <li class="valeur reveal" style={`transition-delay:${i * 60}ms`}>
              <span class="valeur__icone">
                <Icon nom={valeur.data.icone} taille={30} />
              </span>
              <h3 class="valeur__titre">{valeur.data.titre}</h3>
              <p class="valeur__desc">{valeur.data.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .valeurs {
    background: var(--cream-deep);
    padding-block: var(--space-xl);
    border-block: 1px solid var(--line);
  }

  .valeurs__zone {
    position: relative;
  }

  .valeurs__fil {
    display: none;
    position: absolute;
    top: 0.9rem;
    left: 0;
    width: 100%;
    height: 60px;
  }

  .valeurs__grille {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m) var(--space-s);
    list-style: none;
    padding: 0;
  }

  .valeur {
    text-align: center;
  }

  .valeur__icone {
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    margin: 0 auto 0.9rem;
    border-radius: 50%;
    color: var(--ink);
    background: var(--cream-deep);
  }

  .valeur__titre {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 0.45rem;
  }

  .valeur__desc {
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--ink-muted);
    max-width: 15rem;
    margin-inline: auto;
  }

  @media (width >= 40rem) {
    .valeurs__grille {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (width >= 64rem) {
    .valeurs__fil {
      display: block;
    }

    .valeurs__grille {
      grid-template-columns: repeat(7, 1fr);
      gap: var(--space-s) 0.75rem;
    }

    .valeur__desc {
      font-size: 0.8rem;
    }
  }
</style>
