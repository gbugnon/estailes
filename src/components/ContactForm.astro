---
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';

interface Props {
  /** Pré-remplit le sujet, par exemple depuis la page /rendez-vous. */
  sujetParDefaut?: string;
  titre?: string;
}

const { sujetParDefaut = '', titre } = Astro.props;

const prestations = (await getCollection('prestations')).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
---

<div class="formulaire-bloc">
  {titre && <h2 class="formulaire-bloc__titre">{titre}</h2>}

  {/* Message d'erreur affiché si le serveur renvoie ?erreur=1 (voir le script
      en bas). Masqué par défaut, y compris sans JavaScript. */}
  <p class="alerte" role="alert" hidden>
    Votre message n’a pas pu être envoyé. Vérifiez vos informations et réessayez, ou
    appelez-moi directement.
  </p>

  {/* Formulaire HTML classique : il fonctionne sans JavaScript. Le traitement
      est assuré par public/contact-handler.php, exécuté chez Infomaniak — les
      messages ne transitent par aucun service tiers. */}
  <form class="formulaire" method="post" action="/contact-handler.php">
    {/* Piège à robots : un humain ne remplit jamais ce champ. */}
    <div class="piege" aria-hidden="true">
      <label for="site">Ne pas remplir</label>
      <input type="text" id="site" name="site" tabindex="-1" autocomplete="off" />
    </div>

    <div class="champs">
      <p class="champ">
        <label for="nom">Nom et prénom <span aria-hidden="true">*</span></label>
        <input type="text" id="nom" name="nom" required autocomplete="name" />
      </p>

      <p class="champ">
        <label for="email">Adresse e-mail <span aria-hidden="true">*</span></label>
        <input type="email" id="email" name="email" required autocomplete="email" />
      </p>

      <p class="champ">
        <label for="telephone">Téléphone <span class="champ__note">(facultatif)</span></label>
        <input type="tel" id="telephone" name="telephone" autocomplete="tel" />
      </p>

      <p class="champ">
        <label for="sujet">Votre demande</label>
        <select id="sujet" name="sujet">
          <option value="">Je ne sais pas encore</option>
          {
            prestations.map((p) => (
              <option value={p.data.titre} selected={p.data.titre === sujetParDefaut}>
                {p.data.titre}
              </option>
            ))
          }
          <option value="Autre">Autre question</option>
        </select>
      </p>

      <p class="champ champ--large">
        <label for="message">Votre message <span aria-hidden="true">*</span></label>
        <textarea id="message" name="message" rows="6" required aria-describedby="message-aide"
        ></textarea>
        <span id="message-aide" class="champ__note">
          Dites-moi ce qui vous amène et vos disponibilités. Inutile d’entrer dans le détail de
          votre santé ici — nous en parlerons de vive voix.
        </span>
      </p>

      <p class="champ champ--large champ--case">
        <input type="checkbox" id="consentement" name="consentement" required />
        <label for="consentement">
          J’accepte que ces informations soient utilisées pour répondre à ma demande, comme décrit
          dans la <a href="/politique-de-confidentialite">politique de confidentialité</a>.
          <span aria-hidden="true">*</span>
        </label>
      </p>
    </div>

    <button type="submit" class="btn btn--primary">
      Envoyer le message
      <Icon nom="fleche" taille={15} />
    </button>

    <p class="mention-obligatoire">Les champs marqués d’un astérisque sont obligatoires.</p>
  </form>
</div>

<script>
  // Révèle l'alerte quand le serveur PHP renvoie ?erreur=1 après un échec
  // d'envoi. Le reste du formulaire fonctionne sans JavaScript.
  if (new URLSearchParams(location.search).get('erreur') === '1') {
    document.querySelector('.alerte')?.removeAttribute('hidden');
  }
</script>

<style>
  .formulaire-bloc {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: clamp(1.5rem, 1rem + 2.4vw, 2.75rem);
    box-shadow: var(--shadow-card);
  }

  .formulaire-bloc__titre {
    font-size: var(--step-3);
    margin-bottom: var(--space-s);
  }

  .alerte {
    margin-bottom: var(--space-s);
    padding: 0.85rem 1.1rem;
    background: #f6e6d9;
    border: 1px solid #dab89a;
    border-radius: var(--radius);
    color: #7a4a2a;
    font-size: var(--step--1);
  }

  .piege {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .champs {
    display: grid;
    gap: var(--space-s);
    margin-bottom: var(--space-m);
  }

  .champ {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .champ label {
    font-size: var(--step--1);
    font-weight: 600;
  }

  .champ__note {
    font-weight: 400;
    color: var(--ink-muted);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .champ input[type='text'],
  .champ input[type='email'],
  .champ input[type='tel'],
  .champ select,
  .champ textarea {
    width: 100%;
    padding: 0.75em 0.9em;
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: var(--step-0);
    transition:
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .champ textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .champ input:focus,
  .champ select:focus,
  .champ textarea:focus {
    background: #fff;
    border-color: var(--gold-line);
  }

  .champ--case {
    flex-direction: row;
    align-items: flex-start;
    gap: 0.7rem;
  }

  .champ--case input {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.28rem;
    accent-color: var(--sage);
  }

  .champ--case label {
    font-weight: 400;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .champ--case a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--gold-line);
  }

  .mention-obligatoire {
    margin-top: var(--space-s);
    font-size: 0.8rem;
    color: var(--ink-muted);
  }

  @media (width >= 40rem) {
    .champs {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-s) var(--space-m);
    }

    .champ--large {
      grid-column: 1 / -1;
    }
  }
</style>
