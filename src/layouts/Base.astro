---
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-soft-normal.woff2?url';

import '@fontsource-variable/fraunces/soft.css';
import '@fontsource-variable/karla/wght.css';
import '@fontsource/parisienne/400.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import { parametres as p } from '../lib/parametres';

interface Props {
  titre: string;
  description: string;
  /** Masquer la bande d'appel à l'action (page /rendez-vous, où elle ferait doublon). */
  sansCta?: boolean;
  /** Exclure la page des moteurs (404) : pas d'indexation, pas de canonique. */
  horsIndex?: boolean;
  /** Schémas propres à la page, ajoutés au graphe (Service, fil d'Ariane…). */
  schemas?: Record<string, unknown>[];
}

const { titre, description, sansCta = false, horsIndex = false, schemas = [] } = Astro.props;

const titreComplet = titre === 'Accueil' ? `Les sens d’Estelle — ${p.accroche}` : `${titre} · Les sens d’Estelle`;
// Le build produit des dossiers (/a-propos/index.html) et le sitemap déclare la
// barre finale : la canonique doit suivre, sinon les moteurs arbitrent entre deux
// formes de la même page.
const chemin = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonique = new URL(chemin, Astro.site).href;

// Référencement local : Lentigny et canton de Fribourg. Un seul nœud d'entreprise,
// identifié par @id, que les schémas de page peuvent référencer sans le redéclarer.
const idEntreprise = new URL('/#entreprise', Astro.site).href;

const entreprise = {
  '@type': 'HealthAndBeautyBusiness',
  '@id': idEntreprise,
  name: p.nom_site,
  description: p.accroche,
  url: Astro.site?.href,
  telephone: p.telephone,
  email: p.email,
  image: new URL('/images/og-lessensdestelle.png', Astro.site).href,
  logo: new URL('/images/logo.svg', Astro.site).href,
  priceRange: 'CHF 90',
  currenciesAccepted: 'CHF',
  paymentAccepted: 'Espèces, TWINT',
  address: {
    '@type': 'PostalAddress',
    streetAddress: p.adresse_ligne1,
    addressLocality: 'Lentigny',
    addressRegion: 'Fribourg',
    postalCode: '1745',
    addressCountry: 'CH',
  },
  // Émis seulement si les coordonnées ont été relevées : mieux vaut rien qu'un
  // point au mauvais endroit. Pas d'openingHoursSpecification non plus — elle
  // reçoit sur rendez-vous, donc aucun horaire fixe à déclarer.
  ...(p.latitude !== undefined && p.longitude !== undefined
    ? { geo: { '@type': 'GeoCoordinates', latitude: p.latitude, longitude: p.longitude } }
    : {}),
  areaServed: [
    { '@type': 'City', name: 'Lentigny' },
    { '@type': 'AdministrativeArea', name: 'Canton de Fribourg' },
  ],
  availableLanguage: 'fr-CH',
  sameAs: p.reseaux.map((r) => r.url),
};

const donneesStructurees = {
  '@context': 'https://schema.org',
  '@graph': [entreprise, ...schemas],
};

const jsonLd = JSON.stringify(donneesStructurees).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="fr-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    {horsIndex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonique} />}

    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F8F7F3" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Les sens d’Estelle" />
    <meta property="og:locale" content="fr_CH" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={new URL('/images/og-lessensdestelle.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>

  <body>
    <a href="#contenu" class="skip-link">Aller au contenu principal</a>
    <Header />

    <main id="contenu">
      <slot />
      {!sansCta && <CtaBand />}
    </main>

    <Footer />

    <script>
      // Révélation douce au défilement. Le respect de « mouvement réduit » est
      // géré en CSS : ici on se contente de ne pas observer dans ce cas.
      const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const cibles = document.querySelectorAll('.reveal');

      if (reduit || !('IntersectionObserver' in window)) {
        cibles.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observateur = new IntersectionObserver(
          (entrees) => {
            entrees.forEach((entree) => {
              if (!entree.isIntersecting) return;
              entree.target.classList.add('is-visible');
              observateur.unobserve(entree.target);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
        );
        cibles.forEach((el) => observateur.observe(el));
      }
    </script>
  </body>
</html>
