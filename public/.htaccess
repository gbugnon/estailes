# =============================================================================
# Redirections canoniques — d'après la documentation Infomaniak (faq 1961).
#
# Déployé à la racine du site : Astro recopie public/ dans dist/, et l'action
# FTPS envoie dist/. Ne pas déplacer ce fichier.
# =============================================================================

# --- Le journal de déploiement ne regarde personne --------------------------
# Il liste tous les fichiers du site avec leurs empreintes, et était servi
# publiquement en 200.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# --- Redirections -----------------------------------------------------------
# Forme recommandée par Infomaniak. Si une boucle apparaît un jour, remplacer
# « %{HTTPS} off » par « %{HTTP:X-Forwarded-Proto} !https ».
#
# Attention en cas de test : l'hébergement sert des réponses en cache. Une
# redirection qui semble absente peut n'être qu'une réponse mise en cache —
# ajouter « ?v=<horodatage> » à l'URL pour contourner.
RewriteEngine On

RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule (.*) https://lessensdestelle.ch/$1 [R=301,L]
